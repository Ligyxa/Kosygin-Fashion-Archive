# Папка с библиотеками Composer (её не нужно загружать, её можно восстановить)
/vendor/

# Тяжелые 3D-модели (если они весят много, GitHub может не принять их)
# Если модели маленькие, эту строку можно убрать
/assets/models/*.obj
/assets/models/*.glb
/assets/models/*.mtl
/assets/models/*.png

# Загруженные пользователями файлы (чтобы не засорять репозиторий)
/uploads/*
!/uploads/.gitkeep

# Системные файлы
.DS_Store
Thumbs.db